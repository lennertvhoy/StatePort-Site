[Unit]
Description=StatePort staged accepted profile for stateport-worker

[Container]
ContainerName=stateport-d864bc7ef3bf-accepted-@@STATEPORT_REVISION:stateport-worker:accepted@@
Image=ghcr.io/lennertvhoy/stateport-worker@sha256:46d04e8c274192eb980ebeb89ae177abbef1f409a9e6c0b6dddf2acdcb468a23
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:accepted@@.network
Label=io.stateport.source.commit=930c2d9ad3dcc659da9e8a2b966972cfd78f0f0e
Label=io.stateport.source.tree=726d1dcba907d83ed926ffbf977a3ef4fe1e4725
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.10
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=wsl2-ubuntu2404-linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:87d35996ec9d2f7f9f9657f9f4f06ca988b4cf6954051908d0007e6ca0e79ed5
Label=io.stateport.service.id=stateport-worker
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-worker:accepted@@
Label=io.stateport.profile=accepted
Environment=STATEPORT_RELEASE_PROFILE=accepted
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-worker:accepted@@
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-worker:accepted:http@@:8791
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-worker:accepted:http@@
Volume=@@STATEPORT_ACCEPTED_DATA_VOLUME:stateport-shared:stateport-operations@@:/workspace/.stateport:rw,U
HealthCmd="/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8791 --path /readyz"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-worker-accepted
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=1073741824
CPUQuota=200%
TasksMax=512
