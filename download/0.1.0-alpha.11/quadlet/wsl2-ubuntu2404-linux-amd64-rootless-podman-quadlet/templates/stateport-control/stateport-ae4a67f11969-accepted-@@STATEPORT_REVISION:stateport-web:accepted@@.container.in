[Unit]
Description=StatePort staged accepted profile for stateport-web

[Container]
ContainerName=stateport-ae4a67f11969-accepted-@@STATEPORT_REVISION:stateport-web:accepted@@
Image=ghcr.io/lennertvhoy/stateport-web@sha256:e09ab3f6aa6ac8316ed265c2d855ef35405253f0579d7033d1ff3f53cafc6591
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:accepted@@.network
Label=io.stateport.source.commit=57dae10ff94c5b6aa37cc5d23509a89d91887cac
Label=io.stateport.source.tree=c17f0ba7b44cfbf3f30ebe1938d92e640434a640
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.11
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=wsl2-ubuntu2404-linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:d84f4da384de627a2e10f698bb186ad81df4ee5b21238f9df28e55a20d1b8ffc
Label=io.stateport.service.id=stateport-web
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-web:accepted@@
Label=io.stateport.profile=accepted
Environment=STATEPORT_RELEASE_PROFILE=accepted
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-web:accepted@@
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-web:accepted:http@@:8080
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-web:accepted:http@@
Volume=@@STATEPORT_ACCEPTED_DATA_VOLUME:stateport-web:stateport-product-data@@:/var/lib/stateport:rw,U
PodmanArgs=--group-add=keep-groups
Volume=/run/stateport/execution-control:/run/stateport-execution:ro
Environment=STATEPORT_EXECUTION_SOCKET=/run/stateport-execution/control.sock
Environment=STATEPORT_EXECUTION_PEER_POLICY=unix-peer-credentials-required
HealthCmd="/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8080 --path /health"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-web-accepted
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=2147483648
CPUQuota=200%
TasksMax=1024
