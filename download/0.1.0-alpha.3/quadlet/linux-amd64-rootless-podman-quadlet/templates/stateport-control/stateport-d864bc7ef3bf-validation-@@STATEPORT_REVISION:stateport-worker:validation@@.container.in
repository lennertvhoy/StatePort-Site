[Unit]
Description=StatePort staged validation profile for stateport-worker

[Container]
ContainerName=stateport-d864bc7ef3bf-validation-@@STATEPORT_REVISION:stateport-worker:validation@@
Image=ghcr.io/lennertvhoy/stateport-worker@sha256:c12f58d354fb066db0bb2747b8867cfc76db151fb449cdd1fba94c4939f4e1b3
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:validation@@.network
Label=io.stateport.source.commit=fa4ea4b7f08e78669e194c204b59206ab109a02f
Label=io.stateport.source.tree=aec60303045e7a9c8255b941c761d904af85ec10
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.3
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:99d7aa95aff0591c8cec6b4532cafe14b4cafe230509db9769b0673affff96fc
Label=io.stateport.service.id=stateport-worker
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-worker:validation@@
Label=io.stateport.profile=validation
Environment=STATEPORT_RELEASE_PROFILE=validation
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-worker:validation@@
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-worker:validation:http@@:8791
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-worker:validation:http@@
Volume=@@STATEPORT_VALIDATION_VOLUME:stateport-worker:stateport-operations@@:/workspace/.stateport:ro
HealthCmd=/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8791 --path /readyz
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-worker-validation
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=1073741824
CPUQuota=200%
TasksMax=512
