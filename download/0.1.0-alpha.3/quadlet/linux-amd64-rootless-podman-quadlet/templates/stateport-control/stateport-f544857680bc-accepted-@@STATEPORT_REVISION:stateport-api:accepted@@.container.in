[Unit]
Description=StatePort staged accepted profile for stateport-api

[Container]
ContainerName=stateport-f544857680bc-accepted-@@STATEPORT_REVISION:stateport-api:accepted@@
Image=ghcr.io/lennertvhoy/stateport-api@sha256:7d06c67c01bdebd12c917fadd4c8ba6aa552ebd652ca285060af6769df117ac4
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:accepted@@.network
Label=io.stateport.source.commit=fa4ea4b7f08e78669e194c204b59206ab109a02f
Label=io.stateport.source.tree=aec60303045e7a9c8255b941c761d904af85ec10
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.3
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:99d7aa95aff0591c8cec6b4532cafe14b4cafe230509db9769b0673affff96fc
Label=io.stateport.service.id=stateport-api
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-api:accepted@@
Label=io.stateport.profile=accepted
Environment=STATEPORT_RELEASE_PROFILE=accepted
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-api:accepted@@
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-api:accepted:http@@:8790
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-api:accepted:http@@
Volume=@@STATEPORT_ACCEPTED_DATA_VOLUME:stateport-api:stateport-operations@@:/workspace/.stateport:rw
Volume=/run/stateport/execution-control:/run/stateport-execution:ro
Environment=STATEPORT_EXECUTION_SOCKET=/run/stateport-execution/control.sock
Environment=STATEPORT_EXECUTION_PEER_POLICY=unix-peer-credentials-required
HealthCmd=/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8790 --path /readyz
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-api-accepted
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=1073741824
CPUQuota=200%
TasksMax=512
