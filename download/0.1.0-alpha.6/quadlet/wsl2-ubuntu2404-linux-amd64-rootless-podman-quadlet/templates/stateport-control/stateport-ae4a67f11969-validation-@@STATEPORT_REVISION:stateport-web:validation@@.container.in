[Unit]
Description=StatePort staged validation profile for stateport-web

[Container]
ContainerName=stateport-ae4a67f11969-validation-@@STATEPORT_REVISION:stateport-web:validation@@
Image=ghcr.io/lennertvhoy/stateport-web@sha256:945c09cced090aa67e773445e7580a232b9f2174742bddc9dc8fd264de774375
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:validation@@.network
Label=io.stateport.source.commit=f486e3c455f5630a4a416c616566c1cb5072e443
Label=io.stateport.source.tree=b70e58caa709e0431e24df212d952c085cff94df
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.6
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=wsl2-ubuntu2404-linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:0c8019230737c28fbccb95401876fbc1528921e937f27efed536209a3b41c043
Label=io.stateport.service.id=stateport-web
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-web:validation@@
Label=io.stateport.profile=validation
Environment=STATEPORT_RELEASE_PROFILE=validation
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-web:validation@@
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-web:validation:http@@:8080
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-web:validation:http@@
Volume=@@STATEPORT_VALIDATION_VOLUME:stateport-web:stateport-product-data@@:/var/lib/stateport:ro
PodmanArgs=--group-add=keep-groups
Volume=/run/stateport/execution-control:/run/stateport-execution:ro
Environment=STATEPORT_EXECUTION_SOCKET=/run/stateport-execution/control.sock
Environment=STATEPORT_EXECUTION_PEER_POLICY=unix-peer-credentials-required
HealthCmd=/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8080 --path /health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-web-validation
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=2147483648
CPUQuota=200%
TasksMax=1024
