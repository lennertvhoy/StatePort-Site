[Unit]
Description=StatePort staged validation profile for stateport-api

[Container]
ContainerName=stateport-f544857680bc-validation-@@STATEPORT_REVISION:stateport-api:validation@@
Image=ghcr.io/lennertvhoy/stateport-api@sha256:a5c639880195ba6dc57fa9c13378fdf0cdb0361f08cbddea7b7e90f476906af8
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:validation@@.network
Label=io.stateport.source.commit=256d876156fbbde8547ecc04c1ac87d31df70bad
Label=io.stateport.source.tree=e7fb80c5ac2c8bbe6d48dd21e559a02328a70d0c
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.5
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=wsl2-ubuntu2404-linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:1a81b474ccbc99868d321048f4279e53397c7c5f5b2d3a5830de8c20b81081cd
Label=io.stateport.service.id=stateport-api
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-api:validation@@
Label=io.stateport.profile=validation
Environment=STATEPORT_RELEASE_PROFILE=validation
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-api:validation@@
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-api:validation:http@@:8790
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-api:validation:http@@
Volume=@@STATEPORT_VALIDATION_VOLUME:stateport-shared:stateport-operations@@:/workspace/.stateport:ro
HealthCmd=/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8790 --path /readyz
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-api-validation
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=1073741824
CPUQuota=200%
TasksMax=512
