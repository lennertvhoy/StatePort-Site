[Unit]
Description=StatePort staged validation profile for stateport-web

[Quadlet]
DefaultDependencies=false

[Container]
ContainerName=stateport-ae4a67f11969-validation-@@STATEPORT_REVISION:stateport-web:validation@@
Image=ghcr.io/lennertvhoy/stateport-web@sha256:84fcdc1928b4cb8892f1d4bb362d885f98153d1398eb5c1ef6ae08d07bc2088f
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:validation@@.network
Label=io.stateport.source.commit=65e42e8daf68ddbdc9696f7f56ae2365b4023b0e
Label=io.stateport.source.tree=7fcc41327625a83fc12213907f84364b232332b7
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.20
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=wsl2-ubuntu2404-linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:ff6b567836d9553bb5915f27ec1e10d6b9a7082784c5b797ba00cec3077016a9
Label=io.stateport.service.id=stateport-web
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-web:validation@@
Label=io.stateport.profile=validation
Environment=STATEPORT_RELEASE_PROFILE=validation
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-web:validation@@
Environment=STATEPORT_EXECUTION_HOST_WORKSPACE_IMAGE_REFERENCE=ghcr.io/lennertvhoy/stateport-dev-workspace@sha256:6979920b4f759afe906300e0218f456f96ebd8bea96c7e087ce0b1c0650d6399
Environment=STATEPORT_EXECUTION_HOST_WORKSPACE_SPEC_DIGEST=sha256:dcd1521616dc9f4a5cc4ef5ec9e62f700bbe03556da36f94ee178fd81ea364d3
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-web:validation:http@@:8080
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-web:validation:http@@
Volume=@@STATEPORT_VALIDATION_VOLUME:stateport-web:stateport-product-data@@:/var/lib/stateport:ro
Volume=/var/lib/stateport-control/agent-provider:/var/lib/stateport-control/agent-provider:ro
Environment=STATEPORT_AGENT_PROVIDER_DIR=/var/lib/stateport-control/agent-provider
Volume=/var/lib/stateport/imports:/imports:ro
Environment=STATEPORT_REPOSITORY_ROOTS=/imports
Volume=/etc/stateport/workspace-authority:/run/stateport-workspace-authority:ro
Environment=STATEPORT_WORKSPACE_AUTHORITY_DIRECTORY=/run/stateport-workspace-authority
Environment=STATEPORT_APPLICATION_WORKSPACE_BINDINGS=/run/stateport-workspace-authority/bindings.json
Environment=STATEPORT_APPLICATION_WORKSPACE_BINDINGS_FORMAT=stateport.application-workspace-bindings/v2
Environment=STATEPORT_OPENCODE_HOME=/var/lib/stateport-provider/opencode
Tmpfs=/var/lib/stateport-provider/opencode:rw,noexec,nosuid,nodev,notmpcopyup,mode=0700,size=67108864,U
PodmanArgs=--runtime=/usr/libexec/stateport/crun
PodmanArgs=--group-add=keep-groups
Volume=/run/stateport/execution-control:/run/stateport-execution:ro
Environment=STATEPORT_EXECUTION_SOCKET=/run/stateport-execution/control.sock
Environment=STATEPORT_EXECUTION_PEER_POLICY=unix-peer-credentials-required
HealthCmd="/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8080 --path /health"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-web-validation
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=2147483648
CPUQuota=200%
TasksMax=1024
