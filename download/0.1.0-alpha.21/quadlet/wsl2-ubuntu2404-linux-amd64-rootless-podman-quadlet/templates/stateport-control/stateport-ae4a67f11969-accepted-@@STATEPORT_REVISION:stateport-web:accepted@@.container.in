[Unit]
Description=StatePort staged accepted profile for stateport-web

[Quadlet]
DefaultDependencies=false

[Container]
ContainerName=stateport-ae4a67f11969-accepted-@@STATEPORT_REVISION:stateport-web:accepted@@
Image=ghcr.io/lennertvhoy/stateport-web@sha256:7d535d2b03b523826e4411b507d56b6e3765284cdd33c6b9eec14e8e5d5ca9ee
Pull=never
RunInit=true
User=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=keep-id:uid=65532,gid=65532
Network=stateport-@@STATEPORT_NETWORK:stateport-control:accepted@@.network
Label=io.stateport.source.commit=aafc79d45572c714ce10078bb57c38ab20e40aeb
Label=io.stateport.source.tree=318a1c21d715473366e7dae6e5b80e571f7f25eb
Label=io.stateport.release.id=stateport-alpha-0.1.0-alpha.21
Label=io.stateport.release.signed-payload=@@STATEPORT_SIGNED_PAYLOAD_DIGEST@@
Label=io.stateport.target.id=wsl2-ubuntu2404-linux-amd64-rootless-podman-quadlet
Label=io.stateport.target.topology=sha256:ebb903122e4f7a09db2fea0dc0a571039ac4fcd66801800bcf8b359d7979a3c2
Label=io.stateport.service.id=stateport-web
Label=io.stateport.revision.id=@@STATEPORT_REVISION:stateport-web:accepted@@
Label=io.stateport.profile=accepted
Environment=STATEPORT_RELEASE_PROFILE=accepted
Environment=STATEPORT_RELEASE_REVISION=@@STATEPORT_REVISION:stateport-web:accepted@@
Environment=STATEPORT_EXECUTION_HOST_WORKSPACE_IMAGE_REFERENCE=ghcr.io/lennertvhoy/stateport-dev-workspace@sha256:da91bc358a6a0408ec27be0f4f35b9d0fc22bf49f3346e22cff2bad8e91d3646
Environment=STATEPORT_EXECUTION_HOST_WORKSPACE_SPEC_DIGEST=sha256:593ff416010df579934518bdf8416c73aadf3916225b3a2777652814b67bd1da
PublishPort=127.0.0.1:@@STATEPORT_PORT:stateport-web:accepted:http@@:8080
Environment=STATEPORT_EXTERNAL_LOOPBACK_PORT=@@STATEPORT_PORT:stateport-web:accepted:http@@
Volume=@@STATEPORT_ACCEPTED_DATA_VOLUME:stateport-web:stateport-product-data@@:/var/lib/stateport:rw,U
Volume=/var/lib/stateport-control/agent-provider:/var/lib/stateport-control/agent-provider:ro
Environment=STATEPORT_AGENT_PROVIDER_DIR=/var/lib/stateport-control/agent-provider
Volume=/var/lib/stateport/imports:/imports:ro
Environment=STATEPORT_REPOSITORY_ROOTS=/imports
Volume=/etc/stateport/workspace-authority:/run/stateport-workspace-authority:ro
Environment=STATEPORT_WORKSPACE_AUTHORITY_DIRECTORY=/run/stateport-workspace-authority
Environment=STATEPORT_APPLICATION_WORKSPACE_BINDINGS=/run/stateport-workspace-authority/bindings.json
Environment=STATEPORT_APPLICATION_WORKSPACE_BINDINGS_FORMAT=stateport.application-workspace-bindings/v2
Environment=STATEPORT_OPENCODE_HOME=/var/lib/stateport-provider/opencode
Volume=/var/lib/stateport-control/provider-auth/opencode:/var/lib/stateport-provider/opencode:rw
PodmanArgs=--runtime=/usr/libexec/stateport/crun
PodmanArgs=--group-add=keep-groups
Volume=/run/stateport/execution-control:/run/stateport-execution:ro
Environment=STATEPORT_EXECUTION_SOCKET=/run/stateport-execution/control.sock
Environment=STATEPORT_EXECUTION_PEER_POLICY=unix-peer-credentials-required
HealthCmd="/usr/local/bin/stateport-healthcheck --kind http --host 127.0.0.1 --port 8080 --path /health"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10485760

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stateport-web-accepted
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryMax=2147483648
CPUQuota=200%
TasksMax=1024
