{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/install-receipt.v1.schema.json",
  "title": "StatePort installation lifecycle receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receiptId",
    "operation",
    "installer",
    "release",
    "releaseIndexDigest",
    "installPlanDigest",
    "target",
    "host",
    "verification",
    "runtime",
    "dataDisposition",
    "authority",
    "startedAt",
    "finishedAt",
    "result"
  ],
  "properties": {
    "schema": {"const": "stateport.install-receipt/v1"},
    "receiptId": {"type": "string", "pattern": "^install_receipt_[0-9a-f]{32}$"},
    "operation": {"enum": ["install", "uninstall", "purge", "reinstall"]},
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "version", "channel", "signedPayloadDigest", "sourceCommit", "sourceTree"],
      "properties": {
        "releaseId": {"type": "string", "minLength": 3, "maxLength": 128},
        "version": {"$ref": "#/$defs/semver"},
        "channel": {"enum": ["alpha", "stable", "owner-dogfood"]},
        "signedPayloadDigest": {"$ref": "#/$defs/digest"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "releaseIndexDigest": {"$ref": "#/$defs/digest"},
    "installPlanDigest": {"$ref": "#/$defs/digest"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetDigest", "topologyDigest", "quadletArtifactDigest", "quadletBundleDigest", "imageSetDigest", "serviceSetDigest"],
      "properties": {
        "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "targetDigest": {"$ref": "#/$defs/digest"},
        "topologyDigest": {"$ref": "#/$defs/digest"},
        "quadletArtifactDigest": {"$ref": "#/$defs/digest"},
        "quadletBundleDigest": {"$ref": "#/$defs/digest"},
        "imageSetDigest": {"$ref": "#/$defs/digest"},
        "serviceSetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osId", "versionId", "architecture", "cgroupVersion", "podmanVersion", "rootless", "quadlet"],
      "properties": {
        "osId": {"const": "ubuntu"},
        "versionId": {"const": "24.04"},
        "architecture": {"const": "amd64"},
        "cgroupVersion": {"const": "v2"},
        "podmanVersion": {"$ref": "#/$defs/semver"},
        "rootless": {"const": true},
        "quadlet": {"const": true}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signedIndex", "signers", "artifacts", "images"],
      "properties": {
        "signedIndex": {
          "type": "object", "additionalProperties": false,
          "required": ["expectedDigest", "observedDigest", "status"],
          "properties": {
            "expectedDigest": {"$ref": "#/$defs/digest"},
            "observedDigest": {"$ref": "#/$defs/digest"},
            "status": {"enum": ["verified", "failed"]}
          }
        },
        "signers": {
          "type": "array", "minItems": 2, "maxItems": 40,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["subjectKind", "subjectId", "subjectDigest", "trustMode", "bundleDigest", "verifiedAt", "transparencyLogStatus", "status"],
            "properties": {
              "subjectKind": {"enum": ["release-index", "image"]},
              "subjectId": {"type": "string", "pattern": "^(?:release-index|stateport-[a-z0-9][a-z0-9-]{1,62})$"},
              "subjectDigest": {"$ref": "#/$defs/digest"},
              "trustMode": {"enum": ["keyless-certificate", "pinned-public-key"]},
              "certificateIdentity": {"type": "string", "minLength": 1, "maxLength": 512},
              "certificateOidcIssuer": {"type": "string", "pattern": "^https://[^\\s?#]+$"},
              "publicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "publicKeyFingerprintAlgorithm": {"const": "sha256-canonical-der-spki"},
              "publicKeyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
              "bundleDigest": {"$ref": "#/$defs/digest"},
              "verifiedAt": {"$ref": "#/$defs/timestamp"},
              "transparencyLogStatus": {"enum": ["verified", "not-required-private-candidate"]},
              "status": {"enum": ["verified", "failed"]}
            },
            "oneOf": [
              {
                "required": ["certificateIdentity", "certificateOidcIssuer"],
                "properties": {"trustMode": {"const": "keyless-certificate"}}
              },
              {
                "required": ["publicKeyFingerprint", "publicKeyFingerprintAlgorithm", "publicKeyId"],
                "properties": {
                  "trustMode": {"const": "pinned-public-key"},
                  "transparencyLogStatus": {"const": "not-required-private-candidate"}
                }
              }
            ]
          }
        },
        "artifacts": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["artifactId", "expectedDigest", "observedDigest", "status"],
            "properties": {
              "artifactId": {"enum": ["installer", "updater", "compose", "quadlet", "sourceArchive", "releaseNotes", "knownLimitations"]},
              "expectedDigest": {"$ref": "#/$defs/digest"},
              "observedDigest": {"$ref": "#/$defs/digest"},
              "status": {"enum": ["verified", "failed"]}
            }
          }
        },
        "images": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["imageId", "reference", "expectedDigest", "observedDigest", "sizeBytes", "signatureBundleDigest", "cycloneDxDigest", "spdxDigest", "scanDigest", "provenanceDigest", "status"],
            "properties": {
              "imageId": {"type": "string", "pattern": "^stateport-[a-z0-9][a-z0-9-]{1,62}$"},
              "reference": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"},
              "expectedDigest": {"$ref": "#/$defs/digest"},
              "observedDigest": {"$ref": "#/$defs/digest"},
              "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 137438953472},
              "signatureBundleDigest": {"$ref": "#/$defs/digest"},
              "cycloneDxDigest": {"$ref": "#/$defs/digest"},
              "spdxDigest": {"$ref": "#/$defs/digest"},
              "scanDigest": {"$ref": "#/$defs/digest"},
              "provenanceDigest": {"$ref": "#/$defs/digest"},
              "status": {"enum": ["verified", "failed"]}
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseIndexDigest", "signedPayloadDigest", "targetDigest", "topologyDigest", "quadletArtifactDigest", "quadletBundleDigest", "imageSetDigest", "serviceSetDigest", "services", "localUrl", "healthy", "runtimeIdentityDigest"],
      "properties": {
        "releaseId": {"type": "string", "minLength": 3, "maxLength": 128},
        "releaseIndexDigest": {"$ref": "#/$defs/digest"},
        "signedPayloadDigest": {"$ref": "#/$defs/digest"},
        "targetDigest": {"$ref": "#/$defs/digest"},
        "topologyDigest": {"$ref": "#/$defs/digest"},
        "quadletArtifactDigest": {"$ref": "#/$defs/digest"},
        "quadletBundleDigest": {"$ref": "#/$defs/digest"},
        "imageSetDigest": {"$ref": "#/$defs/digest"},
        "serviceSetDigest": {"$ref": "#/$defs/digest"},
        "services": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["serviceId", "imageId", "imageDigest", "healthy"],
            "properties": {
              "serviceId": {"type": "string", "pattern": "^stateport-[a-z0-9][a-z0-9-]{1,62}$"},
              "imageId": {"type": "string", "pattern": "^stateport-[a-z0-9][a-z0-9-]{1,62}$"},
              "imageDigest": {"$ref": "#/$defs/digest"},
              "healthy": {"type": "boolean"}
            }
          }
        },
        "localUrl": {"type": "string", "pattern": "^https?://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?(?:/[^\\s]*)?$"},
        "healthy": {"type": "boolean"},
        "runtimeIdentityDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "dataDisposition": {"enum": ["created", "preserved", "restored", "purged", "not_applicable"]},
    "authority": {
      "oneOf": [
        {"$ref": "#/$defs/installerDirective"},
        {"$ref": "#/$defs/authorityReference"}
      ]
    },
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "finishedAt": {"$ref": "#/$defs/timestamp"},
    "result": {"enum": ["succeeded", "failed", "rolled_back", "not_executed"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "installerDirective": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "directiveId", "directiveKind", "actorId", "installerDigest", "releaseIndexDigest", "planDigest", "directiveDigest", "confirmationReceiptDigest", "confirmedAt"],
      "properties": {
        "kind": {"const": "installer-directive"},
        "directiveId": {"type": "string", "pattern": "^installer_directive_[0-9a-f]{32}$"},
        "directiveKind": {"enum": ["interactive-exact-plan", "signed-owner-directive"]},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 128},
        "installerDigest": {"$ref": "#/$defs/digest"},
        "releaseIndexDigest": {"$ref": "#/$defs/digest"},
        "planDigest": {"$ref": "#/$defs/digest"},
        "directiveDigest": {"$ref": "#/$defs/digest"},
        "confirmationReceiptDigest": {"$ref": "#/$defs/digest"},
        "confirmedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "authorityReference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "action", "actorId", "grantId", "grantDigest", "profile", "configuredPolicy", "effectivePolicy", "scope", "runId", "planDigest", "requestId", "decisionDigest", "reservationId", "reservationDigest", "claimId", "claimDigest"],
      "properties": {
        "kind": {"const": "stateport-authority"},
        "action": {"enum": ["install_release", "uninstall_release", "purge_release_data", "reinstall_release"]},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 128},
        "grantId": {"type": "string", "pattern": "^grant_[A-Za-z0-9._-]{3,120}$"},
        "grantDigest": {"$ref": "#/$defs/digest"},
        "profile": {"enum": ["guarded", "balanced", "delegated", "custom"]},
        "configuredPolicy": {"enum": ["approve_scope_once", "auto_and_notify", "auto_with_receipt"]},
        "effectivePolicy": {"enum": ["approve_scope_once", "auto_and_notify", "auto_with_receipt"]},
        "scope": {"$ref": "#/$defs/authorityScope"},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128},
        "planDigest": {"$ref": "#/$defs/digest"},
        "requestId": {"type": "string", "pattern": "^authority_request_[0-9a-f]{32}$"},
        "decisionDigest": {"$ref": "#/$defs/digest"},
        "reservationId": {"type": "string", "pattern": "^authority_reservation_[0-9a-f]{32}$"},
        "reservationDigest": {"$ref": "#/$defs/digest"},
        "claimId": {"type": "string", "pattern": "^authority_claim_[0-9a-f]{32}$"},
        "claimDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorityScope": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "branch", "sliceId", "applicationId", "runId", "paths"],
      "properties": {
        "repository": {
          "type": "object", "additionalProperties": false,
          "required": ["origin", "repositoryKey", "repositoryRoot"],
          "properties": {
            "origin": {"type": "string", "pattern": "^https://[^\\s?#]+(?:\\.git)?$"},
            "repositoryKey": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "repositoryRoot": {"type": "string", "pattern": "^/", "maxLength": 4096}
          }
        },
        "branch": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "sliceId": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "applicationId": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128},
        "paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    }
  }
}
