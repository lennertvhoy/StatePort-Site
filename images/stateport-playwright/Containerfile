FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

ARG STATEPORT_BUILD_SOURCE_COMMIT=unknown
ARG STATEPORT_BUILD_SOURCE_TREE=unknown
ARG STATEPORT_BUILD_SOURCE_REF=unknown
ARG STATEPORT_BUILD_SOURCE_DIRTY=true
ARG STATEPORT_BUILD_SOURCE_DATE_EPOCH=unknown
ARG STATEPORT_BUILD_VERSION=0.0.0-unknown
ARG STATEPORT_BUILD_CREATED=1970-01-01T00:00:00Z
ARG STATEPORT_BUILD_ADAPTER=unknown
LABEL org.opencontainers.image.title="StatePort Playwright Browser" \
      org.opencontainers.image.source="https://github.com/lennertvhoy/StatePort" \
      org.opencontainers.image.revision="${STATEPORT_BUILD_SOURCE_COMMIT}" \
      org.opencontainers.image.version="${STATEPORT_BUILD_VERSION}" \
      org.opencontainers.image.created="${STATEPORT_BUILD_CREATED}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      io.stateport.source.tree="${STATEPORT_BUILD_SOURCE_TREE}" \
      org.opencontainers.image.ref.name="${STATEPORT_BUILD_SOURCE_REF}" \
      io.stateport.source.dirty="${STATEPORT_BUILD_SOURCE_DIRTY}" \
      io.stateport.source-date-epoch="${STATEPORT_BUILD_SOURCE_DATE_EPOCH}" \
      io.stateport.build.adapter="${STATEPORT_BUILD_ADAPTER}" \
      io.stateport.image.role="browser-sidecar" \
      io.stateport.playwright.version="1.62.1" \
      io.stateport.browser.default="headless"

RUN groupadd --gid 10001 stateport \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/stateport --shell /usr/sbin/nologin stateport \
    && mkdir -p /workspace /artifacts \
    && chown -R 10001:10001 /workspace /artifacts
WORKDIR /opt/stateport-playwright
COPY images/stateport-playwright/package.json images/stateport-playwright/package-lock.json ./
COPY images/bin/stateport-healthcheck /usr/local/bin/stateport-healthcheck
# npm writes wall-clock-named logs and cache index entries under $HOME (see
# the stateport-dev-workspace Containerfile note); build with a throwaway
# HOME/cache so the layer stays OCI-reproducible. npm itself is build-only:
# the runtime CMD invokes the pinned @playwright/test CLI through node
# directly, so npm's bundled dependency tree (tar, brace-expansion, undici)
# is removed from the shipped image rather than carried as dead vulnerable
# surface.
RUN export HOME=/tmp/stateport-build-home \
    && mkdir -p "$HOME" \
    && npm ci --ignore-scripts --omit=dev --audit=false --fund=false \
      --cache /tmp/stateport-npm-cache \
    && chmod 0555 /usr/local/bin/stateport-healthcheck \
    && npx playwright --version | grep -Fx "Version 1.62.1" \
    && node -e 'for (const name of ["@playwright/test", "playwright", "playwright-core"]) { if (require(`${name}/package.json`).version !== "1.62.1") process.exit(1) }' \
    && rm -rf /tmp/stateport-build-home /tmp/stateport-npm-cache /tmp/node-compile-cache \
    && rm -rf /usr/lib/node_modules/npm /usr/bin/npm /usr/bin/npx

ENV HOME=/home/stateport \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    STATEPORT_BROWSER_MODE=headless \
    STATEPORT_BROWSER_ARTIFACTS=/artifacts
WORKDIR /workspace
USER 10001:10001
CMD ["node", "/opt/stateport-playwright/node_modules/@playwright/test/cli.js", "test"]
