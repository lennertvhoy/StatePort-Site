FROM docker.io/library/python:3.13-alpine3.23@sha256:9fdbf2e3e82628351513560b121e2ee6ce31cac212be9e070c5a5e2769fb5e76

ARG STATEPORT_BUILD_SOURCE_COMMIT=unknown
ARG STATEPORT_BUILD_SOURCE_TREE=unknown
ARG STATEPORT_BUILD_SOURCE_REF=unknown
ARG STATEPORT_BUILD_SOURCE_DIRTY=true
ARG STATEPORT_BUILD_SOURCE_DATE_EPOCH=unknown
ARG STATEPORT_BUILD_VERSION=0.0.0-unknown
ARG STATEPORT_BUILD_CREATED=1970-01-01T00:00:00Z
ARG STATEPORT_BUILD_ADAPTER=unknown
LABEL org.opencontainers.image.title="StatePort Execution Host" \
      org.opencontainers.image.source="https://github.com/lennertvhoy/StatePort" \
      org.opencontainers.image.revision="${STATEPORT_BUILD_SOURCE_COMMIT}" \
      org.opencontainers.image.version="${STATEPORT_BUILD_VERSION}" \
      org.opencontainers.image.created="${STATEPORT_BUILD_CREATED}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      io.stateport.source.tree="${STATEPORT_BUILD_SOURCE_TREE}" \
      org.opencontainers.image.ref.name="${STATEPORT_BUILD_SOURCE_REF}" \
      io.stateport.source.dirty="${STATEPORT_BUILD_SOURCE_DIRTY}" \
      io.stateport.source-date-epoch="${STATEPORT_BUILD_SOURCE_DATE_EPOCH}" \
      io.stateport.build.adapter="${STATEPORT_BUILD_ADAPTER}" \
      io.stateport.image.role="execution-host" \
      io.stateport.engine-access="owned-execution-user-podman-socket-only" \
      io.stateport.packaged-content="stateport.packaged-content/v1"

# The daemon talks only to the execution user's own rootless Podman socket
# (mounted at /run/stateport-engine/podman.sock by the stable-host Quadlet).
# podman-remote is the client-only build; no engine runs inside this image.
# The container must never observe a control-plane socket.
# `apk add` writes a wall-clock line to /var/log/apk.log; that log is the
# only byte that differs between otherwise identical builds, so the layer
# deletes it to keep the two-build OCI digest proof reproducible.
RUN apk add --no-cache \
        --repository https://dl-cdn.alpinelinux.org/alpine/edge/main \
        --repository https://dl-cdn.alpinelinux.org/alpine/edge/community \
        aardvark-dns=1.17.1-r0 \
        catatonit=0.2.1-r0 \
        conmon=2.2.1-r0 \
        containers-common=0.64.2-r0 \
        crun=1.28-r0 \
        glib=2.88.2-r0 \
        json-c=0.19-r1 \
        libblkid=2.42.2-r0 \
        libbsd=0.12.2-r0 \
        libcap2=2.78-r0 \
        libeconf=0.8.4-r0 \
        libgcc=15.2.0-r8 \
        libintl=1.0-r0 \
        libmd=1.2.0-r0 \
        libmount=2.42.2-r0 \
        libseccomp=2.6.0-r2 \
        linux-pam=1.7.1-r2 \
        netavark=1.17.2-r0 \
        passt=2026.07.16-r0 \
        pcre2=10.47-r1 \
        podman-remote=5.8.3-r1 \
        skalibs-libs=2.15.1.0-r0 \
        shadow-libs=4.18.0-r1 \
        shadow-subids=4.18.0-r1 \
        utmps-libs=0.1.3.4-r0 \
    && rm -f /var/log/apk.log \
    && rm -rf /var/cache/apk/*
COPY images/bin/stateport-healthcheck /usr/local/bin/stateport-healthcheck
RUN chmod 0555 /usr/local/bin/stateport-healthcheck \
    && addgroup -g 65532 -S stateport-exec \
    && adduser -u 65532 -S -D -H -h /var/lib/stateport/execution-host -s /sbin/nologin -G stateport-exec stateport-exec \
    && mkdir -p /var/lib/stateport/execution-host \
    && chown -R 65532:65532 /var/lib/stateport/execution-host

WORKDIR /workspace
COPY packages/execution-host/src /workspace/packages/execution-host/src
COPY apps/execution-host/src /workspace/apps/execution-host/src

ENV HOME=/var/lib/stateport/execution-host \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/packages/execution-host/src:/workspace/apps/execution-host/src \
    STATEPORT_PODMAN_BINARY=podman-remote \
    STATEPORT_EXECUTION_HOST_SOCKET_GROUP_GID=65534 \
    STATEPORT_EXECUTION_HOST_ALLOWED_CLIENT_UID=65534
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=10s --retries=3 CMD ["/usr/local/bin/stateport-healthcheck", "--kind", "unix-socket", "--path", "/run/stateport-execution/control.sock"]
CMD ["python3", "-m", "stateport_execution_host"]
